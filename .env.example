# Copy to .env and fill after YOU create a Paddle sandbox account.
# Do not invent tokens. Client-side tokens are public by design (test_… / live_…).

PORT=8765
HOST=0.0.0.0

# sandbox | production
PADDLE_ENV=sandbox

# From Paddle Dashboard → Developer tools → Authentication → Client-side tokens
PADDLE_CLIENT_TOKEN=

# Price IDs (pri_…) for each pack — create products/prices in Paddle first
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_BULK=
